FROM ubuntu:jammy AS build

USER root:root
WORKDIR /root/hakobu-fetch/
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update
RUN apt-get install -y curl software-properties-common ca-certificates gnupg

# Install Node.js 24 (used to run the hakobu-fetch build pipeline)
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y nodejs

RUN apt-get install -y binutils g++-12 git make patch python3 python3-setuptools

ARG TARGET_TOOLCHAIN_ARCH

RUN [ `uname -m` = ${TARGET_TOOLCHAIN_ARCH} ] || \
    apt-get install -y binutils-${TARGET_TOOLCHAIN_ARCH}-linux-gnu g++-12-${TARGET_TOOLCHAIN_ARCH}-linux-gnu

ENV CC=${TARGET_TOOLCHAIN_ARCH}-linux-gnu-gcc-12
ENV CXX=${TARGET_TOOLCHAIN_ARCH}-linux-gnu-g++-12
ENV AR=${TARGET_TOOLCHAIN_ARCH}-linux-gnu-ar
ENV NM=${TARGET_TOOLCHAIN_ARCH}-linux-gnu-nm
ENV RANLIB=${TARGET_TOOLCHAIN_ARCH}-linux-gnu-ranlib
ENV READELF=${TARGET_TOOLCHAIN_ARCH}-linux-gnu-readelf
ENV STRIP=${TARGET_TOOLCHAIN_ARCH}-linux-gnu-strip
ENV CC_host=gcc-12
ENV CXX_host=g++-12
ENV AR_host=ar
ENV NM_host=nm
ENV RANLIB_host=ranlib
ENV READELF_host=readelf

COPY . ./

ARG HAKOBU_FETCH_OPTION_a
ARG HAKOBU_FETCH_OPTION_n

# Install deps and compile TypeScript.
# These are build-pipeline tools only — they do not affect the output binary.
# The output binary is determined by Node source + patches + compiler.
RUN npm install --ignore-scripts && npm run build

RUN node lib-es5/bin.js --arch $HAKOBU_FETCH_OPTION_a --node-range $HAKOBU_FETCH_OPTION_n --output dist

FROM scratch
COPY --from=build /root/hakobu-fetch/dist /
