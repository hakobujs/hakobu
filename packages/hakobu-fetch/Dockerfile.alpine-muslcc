ARG HOST_ARCH=x86_64
ARG TARGET_TRIPLE=aarch64-linux-musl

FROM muslcc/$HOST_ARCH:$TARGET_TRIPLE AS build

ARG HAKOBU_FETCH_OPTION_a
ARG HAKOBU_FETCH_OPTION_n
ARG HAKOBU_FETCH_OPTION_p

USER root:root

WORKDIR /root/hakobu-fetch/

# Upgrade alpine because the muslcc image is built on an old base.
RUN sed -i -e 's/v3\.14/v3\.22/g' /etc/apk/repositories && \
    apk update && \
    apk add --upgrade apk-tools && \
    apk upgrade --available

RUN apk add --no-cache build-base git linux-headers npm python3

# https://gitlab.alpinelinux.org/alpine/aports/-/issues/8626
ENV CFLAGS=-U_FORTIFY_SOURCE
ENV CFLAGS_host=-U_FORTIFY_SOURCE
ENV CXXFLAGS=-U_FORTIFY_SOURCE
ENV CXXFLAGS_host=-U_FORTIFY_SOURCE

ENV CC=/bin/gcc
ENV CXX=/bin/g++
ENV AR=/bin/ar
ENV NM=/bin/nm
ENV READELF=/bin/readelf
ENV STRIP=/bin/strip

ENV CC_host=/usr/bin/gcc
ENV CXX_host=/usr/bin/g++
ENV AR_host=/usr/bin/ar
ENV NM_host=/usr/bin/nm
ENV READELF_host=/usr/bin/readelf

COPY . ./

# Install deps and compile TypeScript.
# These are build-pipeline tools only — they do not affect the output binary.
# The output binary is determined by Node source + patches + compiler.
RUN npm install --ignore-scripts && npm run build

RUN node lib-es5/bin.js --arch $HAKOBU_FETCH_OPTION_a --node-range $HAKOBU_FETCH_OPTION_n --platform $HAKOBU_FETCH_OPTION_p --output dist

FROM scratch
COPY --from=build /root/hakobu-fetch/dist /
