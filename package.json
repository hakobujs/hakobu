{
  "name": "hakobu",
  "version": "0.0.0",
  "private": true,
  "description": "Hakobu monorepo — Node.js executable packager for modern ESM applications",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "lint": "pnpm -r run lint",
    "fix": "pnpm -r run fix",
    "test": "pnpm -r run test"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.17.23",
      "js-yaml": "^4.1.1",
      "brace-expansion": "^2.0.2",
      "tmp": "^0.2.4"
    }
  }
}
